# Local development only. Never reuse these settings on a reachable deployment.
# In the server terminal: export LEYLINE_WEB_AUTH_SECRET="$(openssl rand -hex 32)"
LEYLINE_WEB_LOGIN_CODE=123456
LEYLINE_WEB_ALLOW_FIXED_LOGIN_CODE=true
# Relative state and artifact paths resolve against the server's working directory,
# the repository root for `bun run server`.
LEYLINE_PATHS_STATE=dev-state.local
