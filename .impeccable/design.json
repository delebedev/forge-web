      "name": "Battlefield card identity",
      "kind": "card",
      "description": "Art-tile silhouette and persistent identity band. Artwork and game-state badges are supplied by the card.",
      "html": "<div class=\"ds-card\" tabindex=\"0\" aria-label=\"Raging Goblin, 1/1\"><span class=\"ds-name\">Raging Goblin</span><span class=\"ds-pt\">1/1</span></div>",
      "css": ".ds-card{--card-w:132px;position:relative;width:var(--card-w);height:calc(var(--card-w)/1.28);border-radius:5px;background:var(--public-surface);font-family:var(--public-body);transition:transform 120ms ease;box-shadow:0 6px 16px #0005}.ds-name{position:absolute;right:0;bottom:0;left:0;padding:12px calc(var(--card-w)*.28) 5px 6px;background:linear-gradient(180deg,transparent,rgba(4,6,10,.88) 46%);color:#eae7df;font-size:clamp(10px,calc(var(--card-w)*.078),13px);line-height:1.1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-pt{position:absolute;right:3px;bottom:3px;min-width:calc(var(--card-w)*.24);padding:1px 4px;border:1px solid #ffffff38;border-radius:5px;background:rgba(6,8,12,.92);color:#fff;font-size:clamp(9px,calc(var(--card-w)*.1),14px);font-weight:700;line-height:1.25;text-align:center}.ds-card:hover,.ds-card:focus-visible{transform:scale(1.16)}.ds-card:focus-visible{outline:2px solid var(--public-text);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-card{transition:none}}"
    },
    {
      "name": "Stack entry",
      "kind": "custom",
      "description": "Resolution order, ownership and object identity stay readable without a large spell face.",
      "html": "<div class=\"ds-stack\"><span class=\"ds-order\">1</span><div class=\"ds-entry\" tabindex=\"0\"><div class=\"ds-entry-head\"><span class=\"ds-next\">Resolves next</span><span>Yours</span></div><strong>Shock</strong></div></div>",
      "css": ".ds-stack{display:grid;grid-template-columns:18px minmax(0,1fr);gap:10px;color:var(--public-text);font-family:var(--public-body)}.ds-order{padding-top:5px;color:var(--public-muted);font-size:12px;text-align:center}.ds-entry{padding:6px 0 10px;border-bottom:1px solid var(--accent-border)}.ds-entry-head{display:flex;flex-wrap:wrap;gap:4px 10px;margin-bottom:5px;color:var(--public-muted);font-size:11px}.ds-next{color:var(--public-accent)}.ds-entry strong{font:500 14px/1.35 var(--public-body)}.ds-entry:focus-visible{outline:2px solid var(--public-text);outline-offset:4px;}"
    }
