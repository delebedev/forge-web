  "narrative": {
    "northStar": "The spatial tabletop",
    "overview": "A spatial tabletop in warm charcoal. Card art supplies most of the color; off-white text and clay actions organize attention. The interface uses DM Sans throughout, open battlefield space and compact controls. Shared shell colors follow the same theme.\n\nThis records the implemented desktop system. PRODUCT.md owns product truth; .impeccable/gameplay.md owns the gameplay brief. The former green-and-gold, serif card-room direction is superseded.",
    "keyCharacteristics": [
      "Facing creature rows with supporting permanents behind them.",
      "An adaptive hand at the lower edge and a shared stack/decision column on the right.",
      "Visible state and exact choices, with hover and keyboard focus for deeper inspection."
    ],
    "rules": [
      {
        "name": "The Action Accent Rule",
        "body": "Use clay for commitments, priority, combat and legal-action cues. Use off-white boundaries and explicit selection marks to distinguish selection from availability.",
        "section": "colors"
      },
      {
        "name": "The Card Art Rule",
        "body": "Let card art carry richness. Use compact interface text for identity and state; inspect the full face for rules text.",
        "section": "typography"
      },
      {
        "name": "The Visible Commitment Rule",
        "body": "Scroll decision choices inside their body. Keep the decision heading and commitment footer outside that scrolling area.",
        "section": "layout"
      },
      {
        "name": "The Server Authority Rule",
        "body": "Bind gestures and buttons to the exact supplied legal action or prompt candidate. Never infer legality from artwork, card names, visual state or a mana estimate.",
        "section": "components"
      }
    ],
    "dos": [
      "Do keep both life totals, current turn/phase and required decisions visible at the supported desktop sizes.",
      "Do preserve the board/list relationship for exact targets and use keyboard focus as an inspection path.",
      "Do keep component geometry in its owning CSS Module and shared color/type tokens in public-theme.css.",
      "Do retain useful text and known metadata when artwork is missing."
    ],
    "donts": [
      "Don't reintroduce green-and-gold felt, heritage display serifs, glass or decorative glow as the interface theme.",
      "Don't label tapped lands as floating mana or infer a true mana pool.",
      "Don't expose hidden card faces or make replay/spectator inspection perform game actions.",
      "Don't describe mobile, portrait or unbounded card counts as verified by this desktop pass."
    ]
  }
}
