      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared public commitment with hover, focus and disabled feedback.",
      "html": "<button class=\"ds-primary\">Play</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 22px;border:0;border-radius:var(--public-radius);background:var(--public-accent);color:var(--public-bg);font:600 14px/1.4 var(--public-body);cursor:pointer}.ds-primary:hover:not(:disabled){background:var(--public-accent-hover)}.ds-primary:focus-visible{outline:2px solid var(--public-text);outline-offset:4px;}.ds-primary:disabled{opacity:.55;cursor:not-allowed}"
    },
    {
      "name": "Decision choice",
      "kind": "button",
      "refersTo": "choice",
      "description": "An exact server-supplied candidate. Selection uses a boundary and explicit text.",
      "html": "<button class=\"ds-choice\" aria-pressed=\"false\">Opponent</button>",
      "css": ".ds-choice{min-height:44px;padding:12px;border:1px solid transparent;border-bottom-color:var(--public-line);border-radius:3px;background:transparent;color:var(--public-text);font:500 13px/1.4 var(--public-body);text-align:left;cursor:pointer;transition:background 140ms,border-color 140ms}.ds-choice:hover:not(:disabled){background:#efeee80c;border-color:var(--public-muted)}.ds-choice[aria-pressed=true]{background:var(--selected-bg);border-color:var(--selected-border)}.ds-choice:focus-visible{outline:2px solid var(--public-text);outline-offset:4px;}.ds-choice:disabled{opacity:.45;cursor:default}"
    },
    {
      "name": "Email field",
      "kind": "input",
      "refersTo": "input",
      "description": "Visible label and full-width public form input.",
      "html": "<label class=\"ds-field\">Email<input type=\"email\" autocomplete=\"email\" placeholder=\"you@example.com\" /></label>",
      "css": ".ds-field{display:grid;gap:8px;color:var(--public-text);font:500 13px var(--public-body)}.ds-field input{width:100%;min-height:52px;border:1px solid var(--public-line);border-radius:var(--public-radius);padding:13px 14px;background:var(--public-field);color:var(--public-text);font:16px var(--public-body);caret-color:var(--public-accent)}.ds-field input:focus-visible{outline:2px solid var(--public-text);outline-offset:4px;}"
    },
    {
      "name": "Public navigation",
      "kind": "nav",
      "description": "Quiet text links in the shared compact header.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Public\"><a href=\"#about\">About</a><a class=\"ds-contact\" href=\"#contact\">Contact</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:30px}.ds-nav a{padding:10px 0;border:0;background:none;color:var(--public-text);font:14px var(--public-body);text-decoration:none}.ds-nav a:hover,.ds-nav .ds-contact{color:var(--public-accent)}.ds-nav a:focus-visible{outline:2px solid var(--public-text);outline-offset:4px;}"
    },
