<configuration>
    <variable name="LOG_DIR" value="${LEYLINE_LOG_DIR:-logs}" />
    <variable name="RELEASE" value="${SENTRY_RELEASE:-unknown}" />
    <variable name="LOG_PATTERN" value="%date{yyyy-MM-dd'T'HH:mm:ss.SSS,UTC}Z %-5level %logger{36} release=${RELEASE} - %msg %kvp%n" />
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/forge-web.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/forge-web.%d{yyyy-MM-dd,UTC}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>
    <logger name="Exposed" level="WARN" />
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>
</configuration>
