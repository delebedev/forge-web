{
  "name": "forge-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "leyline:check": "node scripts/bootstrap.mjs --leyline-only",
    "server": "./leyline/gradlew :server:run",
    "server:test": "./leyline/gradlew :server:test",
    "server:check": "./leyline/gradlew :server:check",
    "server:build": "./leyline/gradlew :server:installDist",
    "dev": "vite",
    "dev:seed": "bun scripts/seed-dev.mjs",
    "build": "bun run challenge:manifest:check && bun run css:types:check && tsc && vite build",
    "browser:assets": "bun run challenge:manifest && python3 scripts/build-browser-catalog.py && ./leyline/gradlew :browser-engine:browserDistribution :browser-engine:catalogIndex -PruntimeJavaVersion=17 -PbrowserPrune=true && node scripts/build-browser-release.mjs",
    "browser:build": "bun run browser:assets && bun run css:types:check && tsc && vite build --config browser-engine/vite.config.ts",
    "browser-alpha:build": "bun run browser:assets && bun run build",
    "browser:preview": "vite preview --config browser-engine/vite.config.ts --host 127.0.0.1 --port 5179 --strictPort",
    "preview": "vite preview",
    "test": "mkdir -p test-results && bun test src ./e2e/gre-acceptance.test.ts ./e2e/action-completion.test.ts ./scripts/bootstrap.test.ts ./scripts/playwright-ports.test.ts ./scripts/web-wire-schemas.test.ts ./tools/browser-driver/config.test.ts ./tools/browser-driver/generate.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "gre:proto": "node scripts/generate-gre-proto.mjs",
    "api:types": "node scripts/generate-web-openapi.mjs",
    "runtime:check": "scripts/check-server-distribution.sh",
    "format": "prettier --write --ignore-unknown '**/*.{js,mjs,cjs,ts,mts,cts,tsx}'",
    "format:check": "prettier --check --ignore-unknown '**/*.{js,mjs,cjs,ts,mts,cts,tsx}'",
    "fmt": "bun run format && eslint --fix .",
    "check": "bun run format:check && bun run css:types:check && bun run lint && bun run typecheck && bun run typecheck:e2e && bun run test",
    "css:types": "bun scripts/css-module-types.ts",
    "css:types:check": "bun scripts/css-module-types.ts --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --stats-json",
    "screenshots": "bun x playwright test e2e/screenshots.spec.ts",
    "screenshots:desktop": "bun x playwright test --project=chromium e2e/screenshots.spec.ts",
    "screenshots:ipad": "bun x playwright test --project=ipad e2e/screenshots.spec.ts",
    "gre:smoke": "bun x playwright test --project=gre",
    "e2e": "bun scripts/run-e2e.ts",
    "product:smoke": "bun scripts/run-product-smoke.ts",
    "gre": "bun scripts/run-gre.ts",
    "forge-catalog:smoke": "bun scripts/run-forge-catalog.ts",
    "challenge:test": "bun scripts/run-react-challenge.ts",
    "challenge:manifest": "bun scripts/browser-challenge-manifest.ts",
    "challenge:manifest:check": "bun scripts/browser-challenge-manifest.ts --check",
    "challenge:browser:check": "bun scripts/check-browser-challenges.ts",
    "challenge:video": "bun scripts/record-mobile-challenge.ts",
    "seo:check": "bun scripts/check-seo.ts",
    "api:check": "node scripts/generate-web-openapi.mjs --check && bun scripts/check-web-contract.ts",
    "chromatic": "chromatic",
    "build:ci": "bun run challenge:manifest:check && bun run css:types:check && vite build",
    "challenge:saved:check": "bun scripts/check-saved-challenges.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "1.58.2",
    "@storybook/addon-docs": "10.5.4",
    "@storybook/react-vite": "^10.2.7",
    "@types/bun": "^1.3.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "^8.20.0",
    "chromatic": "18.10.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.12.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "storybook": "^10.5.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@sentry/react": "^10.73.0",
    "keyrune": "3.19.0",
    "mana-font": "^1.18.0",
    "protobufjs": "^7.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.3.6"
  }
}
