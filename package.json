{
  "name": "forge-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "bootstrap": "node scripts/dev/bootstrap.mjs",
    "leyline:check": "node scripts/dev/bootstrap.mjs --leyline-only",
    "server": "bun server/main.ts",
    "server:test": "bun test ./server",
    "server:check": "tsc -p server --noEmit && bun test ./server",
    "server:build": "bash scripts/release/build-server.sh",
    "server:build:release": "bash scripts/release/build-server.sh bun-linux-arm64",
    "server:parity": "mkdir -p test-results && bun test ./e2e/server-parity",
    "dev": "vite",
    "dev:seed": "bun scripts/dev/seed-dev.mjs",
    "build": "bun run challenge:manifest:check && bun run css:types:check && tsc && vite build",
    "browser:assets": "bun run challenge:manifest && python3 scripts/build/build-browser-catalog.py && ./leyline/gradlew -p browser-engine browserDistribution catalogIndex cardIndex -PruntimeJavaVersion=17 -PbrowserPrune=true && node scripts/build/build-browser-release.mjs",
    "release:build": "bun run browser:assets && bun run build",
    "preview": "vite preview",
    "test": "mkdir -p test-results/unit && bun test --path-ignore-patterns '**/browser-replay-lifecycle.test.ts' src ./e2e/support/gre-acceptance.test.ts ./e2e/support/gre-request-dispatch.test.ts ./e2e/support/action-completion.test.ts ./scripts/dev/bootstrap.test.ts ./scripts/lib/playwright-ports.test.ts ./scripts/dev/browser-smoke-diagnostics.test.ts ./scripts/build/build-card-image-index.test.ts ./tools/browser-driver/config.test.ts ./tools/browser-driver/generate.test.ts ./server && mv test-results/junit.xml test-results/unit/junit.xml && bun run test:replay-memory",
    "test:replay-memory": "mkdir -p test-results && BUN_JSC_useConcurrentJIT=false bun test ./src/engine/replay/browser-replay-lifecycle.test.ts",
    "typecheck": "tsc --noEmit && tsc -p server --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "gre:proto": "node scripts/build/generate-gre-proto.mjs",
    "runtime:check": "scripts/release/check-server-distribution.sh",
    "format": "prettier --write --ignore-unknown '**/*.{js,mjs,cjs,ts,mts,cts,tsx}'",
    "format:check": "prettier --check --ignore-unknown '**/*.{js,mjs,cjs,ts,mts,cts,tsx}'",
    "fmt": "bun run format && eslint --fix .",
    "check": "bun run format:check && bun run css:types:check && bun run lint && bun run typecheck && bun run typecheck:e2e && bun run test",
    "css:types": "bun scripts/build/css-module-types.ts",
    "css:types:check": "bun scripts/build/css-module-types.ts --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --stats-json",
    "screenshots": "bun x playwright test e2e/product/screenshots.spec.ts",
    "screenshots:desktop": "bun x playwright test --project=chromium e2e/product/screenshots.spec.ts",
    "screenshots:ipad": "bun x playwright test --project=ipad e2e/product/screenshots.spec.ts",
    "gre:smoke": "bun x playwright test --project=gre",
    "e2e": "bun scripts/dev/run-e2e.ts",
    "product:smoke": "bun scripts/dev/run-product-smoke.ts",
    "gre": "bun scripts/dev/run-gre.ts",
    "forge-catalog:smoke": "bun scripts/dev/run-forge-catalog.ts",
    "challenge:test": "bun scripts/challenges/run-react-challenge.ts",
    "challenge:manifest": "bun scripts/challenges/browser-challenge-manifest.ts",
    "challenge:manifest:check": "bun scripts/challenges/browser-challenge-manifest.ts --check",
    "challenge:browser:check": "bun scripts/challenges/check-browser-challenges.ts",
    "challenge:video": "bun scripts/challenges/record-mobile-challenge.ts",
    "seo:check": "bun scripts/build/check-seo.ts",
    "chromatic": "chromatic",
    "build:ci": "bun run challenge:manifest:check && bun run css:types:check && vite build",
    "challenge:saved:check": "bun scripts/challenges/check-saved-challenges.ts",
    "cards:index": "bun scripts/build/build-card-image-index.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "1.58.2",
    "@storybook/addon-docs": "10.5.4",
    "@storybook/addon-vitest": "10.5.4",
    "@storybook/react-vite": "^10.2.7",
    "@types/bun": "^1.3.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "chromatic": "18.10.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "storybook": "^10.5.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "4.1.12",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@sentry/bun": "^10.73.0",
    "@sentry/react": "^10.73.0",
    "keyrune": "3.19.0",
    "mana-font": "^1.18.0",
    "protobufjs": "7.6.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.3.6"
  }
}
